# ------------------------------------------------------------------
# Transacione — variáveis de ambiente
# Copie para .env e preencha. Nenhuma é obrigatória para rodar local:
# sem DATABASE_URL os leads vão para .dados/leads.jsonl, e sem SMTP
# o envio de e-mail é apenas registrado no log.
# ------------------------------------------------------------------

# Porta do servidor (padrão 5000)
PORT=5000

# Postgres — quando ausente, os leads são gravados em arquivo local
# DATABASE_URL=postgresql://usuario:senha@host:5432/transacione

# SMTP para notificação de novos contatos
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=envio@transacione.com.br
# SMTP_PASS=

# Destino das notificações
# CONTACT_EMAIL=contato@transacione.com.br
# CONTACT_EMAIL_PARCEIROS=parceiros@transacione.com.br
